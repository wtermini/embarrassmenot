// Settings every build shares. Signing defaults to "Sign to Run Locally",
// which needs no Apple account; put your own team in Config/Local.xcconfig
// (not in git), e.g.
//
//     DEVELOPMENT_TEAM = ABCDE12345
//     CODE_SIGN_IDENTITY = Apple Development

// The app's name has spaces; its code module's can't.
PRODUCT_NAME = Embarrass Me Not
PRODUCT_MODULE_NAME = EmbarrassMeNot
PRODUCT_BUNDLE_IDENTIFIER = me.termini.embarrassmenot
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_HARDENED_RUNTIME = YES
DEAD_CODE_STRIPPING = YES
ALWAYS_SEARCH_USER_PATHS = NO

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_NSHumanReadableCopyright = Copyright © 2026 William Termini

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
